{"id":"n1","groupes":["Compétences","Techniques","Connaissances théoriques"],"chaine":"compétence, technique, connaissance théorique","cartes":[{"id":"C1","g":0,"type":"competence","code":"C1","titre":"S’équiper et se déséquiper","couleur":"#6B5B3E","texte":[{"titre":"Attendu","texte":"Mettre en œuvre son équipement de manière autonome et en vérifier le bon fonctionnement."},{"titre":"Comportement","texte":"Autonome, respecte les consignes de sécurité, développe l’entraide et la solidarité de palanquée."},{"titre":"Évaluation","texte":"Gère son équipement sans l’assistance de l’encadrant, au sec comme dans l’eau."}]},{"id":"C2","g":0,"type":"competence","code":"C2","titre":"Se mettre à l’eau et sortir de l’eau","couleur":"#A63D2F","texte":[{"titre":"Attendu","texte":"Se mettre à l’eau et en sortir en sécurité pour soi et pour les autres, selon les modalités définies par le GP."},{"titre":"Comportement","texte":"Adapté au contexte et au type d’embarcation, attentif aux consignes du DP."},{"titre":"Évaluation","texte":"Techniques les plus usuelles maîtrisées ; en milieu artificiel, situations les plus proches possible de la réalité."}]},{"id":"C3","g":0,"type":"competence","code":"C3","titre":"S’immerger","couleur":"#1F5F8B","texte":[{"titre":"Attendu","texte":"S’immerger selon la technique définie par le GP, dans le respect de ses consignes."},{"titre":"Comportement","texte":"Adapté à la demande du GP."},{"titre":"Évaluation","texte":"Canard et phoque maîtrisés ; immersion rapide à la commande."}]},{"id":"C4","g":0,"type":"competence","code":"C4","titre":"Se propulser","couleur":"#2E7D6B","texte":[{"titre":"Attendu","texte":"Assurer ses déplacements de manière autonome, en surface comme en immersion."},{"titre":"Comportement","texte":"Gère son effort, souci de l’unité de la palanquée, reste à proximité du GP."},{"titre":"Évaluation","texte":"100 m PMT et 50 m capelé. Qualité et efficacité du geste ; aucune épreuve chronométrée."}]},{"id":"C5","g":0,"type":"competence","code":"C5","titre":"Se ventiler","couleur":"#3B4EA0","texte":[{"titre":"Attendu","texte":"Gérer et adapter sa ventilation, réagir sereinement à une entrée d’eau dans le masque."},{"titre":"Comportement","texte":"Ventilation maintenue en zone de confort, autocontrôle par apnées, vidage sans stress."},{"titre":"Évaluation","texte":"Effort normal à modéré, situations variées, zone 0 à 6 m, rien de brutal."}]},{"id":"C6","g":0,"type":"competence","code":"C6","titre":"S’équilibrer","couleur":"#7B3F9D","texte":[{"titre":"Attendu","texte":"Gérer sa stabilité au poumon ballast et au gilet, de manière autonome."},{"titre":"Comportement","texte":"S’équilibre à la demande, réactif aux variations de profondeur."},{"titre":"Évaluation","texte":"Situations variées, répétitives, en statique et en dynamique, variation de ± 1 m."}]},{"id":"C7","g":0,"type":"competence","code":"C7","titre":"Communiquer","couleur":"#B5720F","texte":[{"titre":"Attendu","texte":"Comprendre et échanger les informations utiles à la gestion de la plongée avec le GP et les autres plongeurs."},{"titre":"Comportement","texte":"Attentif, réactif, prend l’initiative sans attendre le questionnement du GP."},{"titre":"Évaluation","texte":"Compréhension et réalisation, en statique et en dynamique, seul ou en palanquée."}]},{"id":"C8","g":0,"type":"competence","code":"C8","titre":"Appliquer les conduites de sécurité","couleur":"#A61239","texte":[{"titre":"Attendu","texte":"Être familiarisé à la mise en œuvre des procédures liées aux situations rencontrées."},{"titre":"Comportement","texte":"Exécute sans hésitation, accepte calmement la procédure du GP, interprète le signe et agit immédiatement."},{"titre":"Évaluation","texte":"Accoutumance par la répétition et la variété des situations."}]},{"id":"C9","g":0,"type":"competence","code":"C9","titre":"Respecter le milieu et l’environnement","couleur":"#4B7A21","texte":[{"titre":"Attendu","texte":"Adopter une attitude éco-responsable et évoluer en connaissance du milieu."},{"titre":"Comportement","texte":"Limite son impact, développe sa capacité d’observation."},{"titre":"Évaluation","texte":"Au cours des plongées en milieu naturel."}]},{"id":"C10","g":0,"type":"competence","code":"C10","titre":"Retourner en surface","couleur":"#0E7C97","texte":[{"titre":"Attendu","texte":"Gérer son retour en surface en sécurité, en respectant les consignes du GP."},{"titre":"Comportement","texte":"Attentif à la cohésion de la palanquée, sait revenir en surface et se signaler en cas de perte de palanquée."},{"titre":"Évaluation","texte":"Gère sa remontée seul ou en palanquée et se met en sécurité en surface."}]},{"id":"EQU-01","g":1,"type":"technique","code":"EQU-01","titre":"Gréage du scaphandre","repere":"Bouteille, gilet, détendeur montés sans erreur.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"EQU-02","g":1,"type":"technique","code":"EQU-02","titre":"Dégréage du scaphandre","repere":"Démontage sans erreur, matériel rendu en état.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"EQU-03","g":1,"type":"technique","code":"EQU-03","titre":"Contrôle avant plongée","repere":"Pression de la bouteille, fonctionnement du gilet et du détendeur.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"EQU-04","g":1,"type":"technique","code":"EQU-04","titre":"Capelage et décapelage au sec","repere":"Seul, sans aide, sans risque de chute de bouteille.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"EQU-05","g":1,"type":"technique","code":"EQU-05","titre":"Capelage et décapelage dans l’eau","repere":"Équipement en surface et dans l’eau, en autonomie.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"EQU-06","g":1,"type":"technique","code":"EQU-06","titre":"Choix de son matériel personnel","repere":"Matériel adapté à sa morphologie et au milieu.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"EQU-07","g":1,"type":"technique","code":"EQU-07","titre":"Lestage adapté","repere":"Approprié au milieu (eau douce, eau salée) et au matériel.","etiquettes":["Bassin possible"],"comp":"C1"},{"id":"MEO-01","g":1,"type":"technique","code":"MEO-01","titre":"Saut droit en PMT","repere":"Technique de mise à l’eau en plongée libre.","etiquettes":["Bassin possible"],"comp":"C2"},{"id":"MEO-02","g":1,"type":"technique","code":"MEO-02","titre":"Saut droit en scaphandre","repere":"Masque et détendeur tenus, regard à l’horizon, zone dégagée.","etiquettes":["Bassin possible"],"comp":"C2"},{"id":"MEO-03","g":1,"type":"technique","code":"MEO-03","titre":"Bascule arrière","repere":"Depuis un support bas, tête rentrée, masque et embout tenus.","etiquettes":["Milieu naturel"],"comp":"C2"},{"id":"MEO-04","g":1,"type":"technique","code":"MEO-04","titre":"Départ plage","repere":"Progression à reculons, palmage dès la profondeur suffisante.","etiquettes":["Milieu naturel"],"comp":"C2"},{"id":"MEO-05","g":1,"type":"technique","code":"MEO-05","titre":"Retrait du bloc-gilet en surface","repere":"Sans perdre l’ensemble, en restant ventilé et flottant.","etiquettes":["Bassin possible"],"comp":"C2"},{"id":"MEO-06","g":1,"type":"technique","code":"MEO-06","titre":"Passage à un support de plongée","repere":"Échelle, plage arrière, bord de bassin, selon le support.","etiquettes":["Bassin possible"],"comp":"C2"},{"id":"IMM-01","g":1,"type":"technique","code":"IMM-01","titre":"Canard en PMT","repere":"Bascule franche, jambes tendues hors de l’eau.","etiquettes":["Bassin possible"],"comp":"C3"},{"id":"IMM-02","g":1,"type":"technique","code":"IMM-02","titre":"Canard en scaphandre","repere":"Même technique, charge et volume du scaphandre en plus.","etiquettes":["Bassin possible"],"comp":"C3"},{"id":"IMM-03","g":1,"type":"technique","code":"IMM-03","titre":"Phoque en PMT","repere":"Coulée expiratoire, immersion tête haute.","etiquettes":["Bassin possible"],"comp":"C3"},{"id":"IMM-04","g":1,"type":"technique","code":"IMM-04","titre":"Phoque en scaphandre","repere":"Purge du gilet et expiration, sans palmage vers le bas.","etiquettes":["B